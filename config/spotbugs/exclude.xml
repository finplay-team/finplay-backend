<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs 제외 규칙. 오탐이 재현 확인된 패턴만 추가한다 (추측성 제외 금지). -->
<FindBugsFilter>
    <!-- Spring 진입점 클래스는 분석 실익이 없다 -->
    <Match>
        <Class name="~.*Application" />
    </Match>
    <!-- 재현 확인(이슈 #104 ⑩): WebSocketHandler 콜백(afterConnectionEstablished)이 넘겨주는 WebSocketSession은
         살아있는 연결 핸들이라 방어적 복사가 불가능하다(복사본은 실제 연결이 아니게 됨). subscribe()·isConnected()·
         stop()이 콜백 밖에서 이 세션으로 메시지 전송·연결상태 확인·종료를 수행해야 하므로 필드 보관이 구조적으로
         불가피하다 — ai/agent-mistakes.md 2026-07-29 패턴(손으로 쓴 생성자 → @RequiredArgsConstructor)은 생성자
         주입 필드에만 적용되고, 콜백이 매번 갱신하는 이 필드에는 적용되지 않는다. 클래스+필드+버그패턴 3중으로
         좁혀 다른 EI_EXPOSE_REP2 오탐까지 함께 숨기지 않는다.
         이슈 #564에서 이 필드가 세대(generation)별로 격리된 중첩 클래스 ConnectionSession으로 옮겨졌다 — 같은
         이유로 여전히 불가피해 제외 대상 클래스명만 갱신했다. -->
    <Match>
        <Class name="com.finplay.api.domain.market.feed.BithumbWebSocketFeedClient$ConnectionSession" />
        <Field name="session" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <!-- 재현 확인(이슈 #564): ai/agent-mistakes.md 2026-07-30 패턴 — 빈에 @Value 주입 파라미터가 하나라도 있으면
         Lombok @RequiredArgsConstructor를 쓸 수 없어 생성자를 손으로 쓰는데, 2026-07-29 패턴대로 손으로 쓴
         생성자의 필드 저장만 EI_EXPOSE_REP2로 잡힌다(Lombok이 생성한 동일 패턴은 잡히지 않음, 프로브로 확인된
         SpotBugs 특성). BithumbFeedLeaderLock(lock-ttl-seconds)·BithumbFeedLifecycle(election-interval-ms)
         둘 다 election-interval-ms 값을 @Value로 받아야 해서 이 패턴을 피할 수 없다. 클래스+필드+버그패턴
         3중으로 좁혀 다른 EI_EXPOSE_REP2 오탐까지 함께 숨기지 않는다. -->
    <Match>
        <Class name="com.finplay.api.domain.market.feed.BithumbFeedLeaderLock" />
        <Field name="redisLock" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="com.finplay.api.domain.market.feed.BithumbFeedLifecycle" />
        <Field name="bithumbFeedLeaderLock" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
</FindBugsFilter>
