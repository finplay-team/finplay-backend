# 이 파일을 terraform.tfvars로 복사해서 실제 값으로 채운다. terraform.tfvars는 민감정보가
# 없어도 환경별로 갈릴 수 있어 .gitignore 대상이다.
#
# 대부분의 변수는 variables.tf에 이미 이 프로젝트에 맞는 기본값이 들어 있어, 보통은 이 파일
# 없이 `terraform apply`만 해도 된다. 아래 값들을 바꿔야 할 상황에만 오버라이드한다.

# project_name       = "finplay"
# domain_name        = "finplay.site"
# github_repository  = "finplay-team/finplay-backend"
# deploy_branch      = "dev"
# ec2_instance_type  = "t4g.small"
# rds_instance_class = "db.t4g.small"
